# ─── AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (free tier — 1500 requests/day)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (used for the bull_advocate forecast role)
OPENAI_API_KEY=

# DeepSeek (used for the risk_contrarian forecast role — OpenAI-wire-compatible)
DEEPSEEK_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trading:trading_local@postgres:5432/trading
REDIS_URL=redis://redis:6379/0

# ─── Trading mode: paper | live ──────────────────────────────────────
PREDICTION_TRADING_MODE=paper

# ─── Polymarket (live execution only) ─────────────────────────────────
# DANGER: this key controls a real wallet with real funds once PREDICTION_TRADING_MODE=live
# AND the bot is armed via POST /api/settings/arm-live. Leave empty for paper trading.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# ─── Portfolio ──────────────────────────────────────────────────────────
PORTFOLIO_STARTING_BALANCE=1000.0

# ─── News & Sentiment ─────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_org_key

# ─── Bot Config ───────────────────────────────────────────────────────
BOT_NAME=Apex Prediction Bot
BOT_VERSION=v2
