# ─── AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (free tier — 1500 requests/day)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trading:trading_local@postgres:5432/trading
REDIS_URL=redis://redis:6379/0

# ─── Trading mode: paper | live ──────────────────────────────────────
TRADING_MODE=paper

# ─── Alpaca (US Stocks) ───────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true          # true = paper trading endpoint

# ─── Binance (Crypto) ─────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret
# No key needed for paper mode — public WebSocket used for data

# ─── Zerodha Kite (India Stocks) ──────────────────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_USER_ID=your_zerodha_user_id
KITE_PASSWORD=your_zerodha_password
KITE_TOTP_SECRET=your_totp_secret   # for 2FA auto-login

# ─── OANDA (Forex) ────────────────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_PRACTICE=true        # true = practice/demo account

# ─── News & Sentiment ─────────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_org_key
CRYPTO_PANIC_API_KEY=your_cryptopanic_api_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# ─── Bot Config ───────────────────────────────────────────────────────
EPISODE_START_EQUITY=100.0
EPISODE_GOAL_MULTIPLIER=5.0     # 5x = $500 goal from $100 start
SIGNAL_COOLDOWN_SECONDS=60
BOT_NAME=Apex Trading Bot
BOT_VERSION=v1
